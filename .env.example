# ==========================================
# Ask Your Data - Environment Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security & Cryptography
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-super-secret-jwt-signing-key-32-chars-min
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZmVybmV0LWtleS0xMjM0NTY=

# JWT Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Metadata Database (PostgreSQL)
# Async URL for FastAPI (asyncpg)
METADATA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/askyourdata
# Sync URL for Alembic migrations & background sync operations (psycopg2)
METADATA_DATABASE_SYNC_URL=postgresql://postgres:postgres@postgres:5432/askyourdata

# Redis (Caching, Rate Limiting, Celery broker)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# DuckDB Internal Storage (File uploads)
DUCKDB_DATABASE_PATH=/data/askyourdata.duckdb

# Default Admin Bootstrap (Provisioned on startup if no users exist)
ADMIN_EMAIL=admin@askyourdata.local
ADMIN_PASSWORD=admin123456

# AI Configuration (Disabled by default per non-negotiables)
AI_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
SEND_SAMPLE_ROWS_TO_LLM=false

